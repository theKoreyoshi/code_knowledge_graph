{
  "project_name": "embedded-demo",
  "title": "嵌入式工程代码知识图谱（使用厂商头文件桩）",
  "source_root": "C:/path/to/your/embedded-project",
  "output_dir": "./ckg-out",

  "include_dirs": ["inc"],
  "std_shim_dirs": ["../../ckg/shims"],
